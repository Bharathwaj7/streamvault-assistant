# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY="Entry your Groq API Key"
#To create a Groq API key, first sign in or create an account at [Groq Console](https://console.groq.com). After logging in, open the API Keys section from the dashboard and click Create API Key. Give the key a name, generate it, and copy the key immediately since it may not be shown again. You can then use this key in the environment variable `GROQ_API_KEY`.

GROQ_MODEL=llama-3.3-70b-versatile

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY="change_this_to_a_random_32char_string"
#This is an example SECRET_KEY: a3f8c2e1b7d94f6a2e5c8b1d3f7a9e2c4b6d8f0a1c3e5b7d9f2a4c6e8b0d2f4
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=StreamVault Analytics Assistant
APP_ENV=development
LOG_LEVEL=INFO
ADMIN_PASSWORD=streamvault2025
ANALYST_PASSWORD=analyst123

# ── Paths (defaults work with Docker) ────────────────────────────────────────
DATA_DIR=/app/data
SQLITE_DB_PATH=/app/data/sqlite/streamvault.db
CHROMA_DB_PATH=/app/data/chroma

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
